                </div>\n                        <div data-for=\"lakas\" class=\"col-md-4  form-group\">\n                            <label mbr-text mbr-theme-style=\"display-7\" for=\"phone\" class=\"form-control-label mbr-fonts-style\">Lakás címe</label>\n                            <input type=\"text\" name=\"lakas\" data-form-field=\"Lakas\" mbr-theme-style=\"display-7\" class=\"form-control\">\n                        </div>\n\n<div data-for=\"oraszam1\" class=\"col-md-6  form-group\">\n                            <label mbr-text mbr-theme-style=\"display-7\" for=\"oraszam1\" class=\"form-control-label mbr-fonts-style\">Első melegvízóra száma</label>\n                            <input type=\"text\" name=\"oraszam1\" data-form-field=\"Oraszam1\" mbr-theme-style=\"display-7\" class=\"form-control\">\n                        </div>\n\n<div data-for=\"allas1\" class=\"col-md-6  form-group\">\n                            <label mbr-text mbr-theme-style=\"display-7\" for=\"allas1\" class=\"form-control-label mbr-fonts-style\">Állása</label>\n                            <input type=\"text\" name=\"allas1\" data-form-field=\"Allas1\" mbr-theme-style=\"display-7\" class=\"form-control\">\n                        </div>                        \n\n                        \n<div data-for=\"oraszam2\" class=\"col-md-6  form-group\">\n                            <label mbr-text mbr-theme-style=\"display-7\" for=\"oraszam2\" class=\"form-control-label mbr-fonts-style\">Második melegvízóra száma (ha van)</label>\n                            <input type=\"text\" name=\"oraszam2\" data-form-field=\"Oraszam2\" mbr-theme-style=\"display-7\" class=\"form-control\">\n                        </div>\n\n<div data-for=\"allas2\" class=\"col-md-6  form-group\">\n                            <label mbr-text mbr-theme-style=\"display-7\" for=\"allas2\" class=\"form-control-label mbr-fonts-style\">Állása</label>\n                            <input type=\"text\" name=\"allas2\" data-form-field=\"Allas2\" mbr-theme-style=\"display-7\" class=\"form-control\">\n                        </div>                          \n\n\n\n\n\n\n                        <div data-for=\"message\" class=\"col-md-12 form-group\">\n                            <label mbr-text mbr-theme-style=\"display-7\" for=\"message\" class=\"form-control-label mbr-fonts-style\">Üzenete, ha van</label>\n                            <textarea name=\"message\" data-form-field=\"Message\" mbr-theme-style=\"display-7\" class=\"form-control\"></textarea>\n                        </div>\n                        <div class=\"col-md-12 input-group-btn align-center\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnLink,-mbrBtnAdd\"><a type=\"submit\" class=\"btn btn-primary btn-form\" data-app-placeholder=\"Type Text\">KÜLDÉS</a></div>\n                    </div>\n                </form><!---Formbuilder Form--->\n            </div>\n        </div>\n    </div>\n</section>",
